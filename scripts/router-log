#!/usr/bin/env bash
# Lightweight outcome log. Fields are optional; omit unknowns rather than inventing them.
set -euo pipefail

log="${HOME}/.ajax-router/outcome.tsv"
requested_agent="" actual_agent="" success="" revision_needed=""
escaped_defect="" cost="" duration="" routing_event=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --log) log="${2:?--log requires a value}" ; shift 2 ;;
    --requested-agent) requested_agent="${2:?}" ; shift 2 ;;
    --actual-agent) actual_agent="${2:?}" ; shift 2 ;;
    --success) success="${2:?}" ; shift 2 ;;
    --revision-needed) revision_needed="${2:?}" ; shift 2 ;;
    --escaped-defect) escaped_defect="${2:?}" ; shift 2 ;;
    --cost) cost="${2:?}" ; shift 2 ;;
    --duration) duration="${2:?}" ; shift 2 ;;
    --routing-event) routing_event="${2:?}" ; shift 2 ;;
    *) echo "error: unknown argument: $1" >&2; exit 2 ;;
  esac
done

require_tab_free() {
  case "$1" in
    *$'\t'*|*$'\n'*) echo "error: --$2 contains a tab or newline" >&2; exit 2 ;;
  esac
}

[[ -n "$requested_agent" ]] || { echo "error: --requested-agent is required" >&2; exit 2; }
[[ -n "$actual_agent" ]] || { echo "error: --actual-agent is required" >&2; exit 2; }

for pair in \
  "requested-agent:$requested_agent" \
  "actual-agent:$actual_agent" \
  "success:$success" \
  "revision-needed:$revision_needed" \
  "escaped-defect:$escaped_defect" \
  "cost:$cost" \
  "duration:$duration"
do
  require_tab_free "${pair#*:}" "${pair%%:*}"
done

[[ "$requested_agent" =~ ^(parent|cursor|codex|pi)$ ]] || {
  echo "error: invalid requested-agent" >&2; exit 2
}
[[ "$actual_agent" =~ ^(parent|cursor|codex|pi)$ ]] || {
  echo "error: invalid actual-agent" >&2; exit 2
}
if [[ -n "$success" && ! "$success" =~ ^(true|false)$ ]]; then
  echo "error: invalid success" >&2; exit 2
fi
if [[ -n "$revision_needed" && ! "$revision_needed" =~ ^(true|false)$ ]]; then
  echo "error: invalid revision-needed" >&2; exit 2
fi
if [[ -n "$escaped_defect" && ! "$escaped_defect" =~ ^(true|false)$ ]]; then
  echo "error: invalid escaped-defect" >&2; exit 2
fi
if [[ -n "$duration" && ! "$duration" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "error: invalid duration" >&2; exit 2
fi

mkdir -p "$(dirname "$log")"
timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
  v1 "$timestamp" "$requested_agent" "$actual_agent" \
  "${success:-}" "${revision_needed:-}" "${escaped_defect:-}" \
  "${cost:-}" "${duration:-}" >> "$log"

if [[ -n "$routing_event" ]]; then
  events_log="$(dirname "$log")/routing-events.jsonl"
  python3 - "$events_log" "$timestamp" "$requested_agent" "$actual_agent" "$routing_event" <<'PY'
import json, sys
path, ts, requested, actual, raw = sys.argv[1:6]
try:
    payload = json.loads(raw)
except json.JSONDecodeError as exc:
    print(f"error: invalid --routing-event JSON: {exc}", file=sys.stderr)
    raise SystemExit(2)
record = {
    "timestamp": ts,
    "requested_agent": requested,
    "actual_agent": actual,
}
if isinstance(payload, dict):
    record.update(payload)
else:
    record["payload"] = payload
with open(path, "a", encoding="utf-8") as handle:
    handle.write(json.dumps(record, sort_keys=True) + "\n")
PY
fi

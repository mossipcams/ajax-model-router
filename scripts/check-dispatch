#!/usr/bin/env bash
set -euo pipefail

# Validate a dispatch package for a progressive dispatch level.
# Usage: scripts/check-dispatch LEVEL PATH
# LEVEL: direct | compact | full

[[ $# -eq 2 ]] || {
  echo "Usage: scripts/check-dispatch LEVEL PATH" >&2
  exit 2
}

level="$1"
packet="$2"
# Resolve through symlinks so worktree installs still find canonical scripts.
ROOT="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")")/.." && pwd -P)"

[[ -f "$packet" ]] || {
  echo "missing-file: $packet" >&2
  exit 2
}

case "$level" in
  direct|compact|full) ;;
  *)
    echo "invalid-level: $level" >&2
    exit 2
    ;;
esac

failures=0

require_pattern() {
  local pattern="$1" label="$2"
  if ! grep -Eq -- "$pattern" "$packet"; then
    echo "missing-or-invalid: $label" >&2
    failures=$((failures + 1))
  fi
}

require_section() {
  local section="$1"
  if ! awk -v heading="## $section" '
    $0 == heading {inside=1; next}
    inside && /^## / {exit}
    inside && NF {found=1}
    END {exit !found}
  ' "$packet"; then
    echo "missing-or-empty: $section" >&2
    failures=$((failures + 1))
  fi
}

forbid_section() {
  local section="$1"
  if grep -Fxq -- "## $section" "$packet"; then
    echo "forbidden-section: $section" >&2
    failures=$((failures + 1))
  fi
}

if [[ "$level" == "full" ]]; then
  if ! "$ROOT/scripts/check-packet" "$packet"; then
    exit 1
  fi
  echo "dispatch checks passed (full)"
  exit 0
fi

if [[ "$level" == "direct" ]]; then
  require_pattern '^DISPATCH_LEVEL: direct$' "DISPATCH_LEVEL"
  for section in \
    "User request" \
    "Allowed files" \
    "Acceptance criteria" \
    "Verification commands" \
    "Stop conditions"
  do
    require_section "$section"
  done
  # Direct must stay minimal: no implementation plans or repo summaries.
  forbid_section "Context evidence"
  forbid_section "Edit instructions"
  forbid_section "Code anchors"
  forbid_section "Implementation plan"
  forbid_section "Repository summary"
elif [[ "$level" == "compact" ]]; then
  require_pattern '^PACKET_STATUS: READY$' "PACKET_STATUS"
  require_pattern '^DISPATCH_LEVEL: compact$' "DISPATCH_LEVEL"
  require_pattern '^UNRESOLVED_UNCERTAINTY: NONE$' "UNRESOLVED_UNCERTAINTY"
  require_pattern '^BLOCKERS: \[\]$' "empty BLOCKERS"
  for section in \
    "Goal" \
    "Allowed files" \
    "Forbidden changes" \
    "Code anchors" \
    "Edit instructions" \
    "Verification commands" \
    "Acceptance criteria" \
    "Stop conditions"
  do
    require_section "$section"
  done
  forbid_section "Context evidence"
fi

# Shared size guard (mirrors lifecycle_context.DISPATCH_LIMITS).
python3 - "$level" "$packet" <<'PY'
import sys
from pathlib import Path

limits = {
    "direct": {"max_bytes": 8192, "max_lines": 200},
    "compact": {"max_bytes": 24576, "max_lines": 600},
    "full": {"max_bytes": 65536, "max_lines": 2000},
}
level, path = sys.argv[1], Path(sys.argv[2])
text = path.read_text()
raw = text.encode("utf-8")
lines = text.count("\n") + (1 if text and not text.endswith("\n") else 0)
cap = limits[level]
if len(raw) > cap["max_bytes"]:
    print(f"exceeds-byte-limit: {len(raw)} > {cap['max_bytes']}", file=sys.stderr)
    raise SystemExit(1)
if lines > cap["max_lines"]:
    print(f"exceeds-line-limit: {lines} > {cap['max_lines']}", file=sys.stderr)
    raise SystemExit(1)
PY

((failures == 0)) || exit 1
echo "dispatch checks passed ($level)"

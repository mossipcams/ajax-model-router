#!/usr/bin/env bash
# Contract pins for harness-boundary Ajax Model Router.
set -euo pipefail

ROOT="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")")/.." && pwd -P)"
# Prefer Homebrew Python when /usr/bin/python3 is too old for the suite.
if [[ -x /opt/homebrew/bin/python3 ]]; then
  export PATH="/opt/homebrew/bin:$PATH"
fi
PYTHON="${PYTHON:-python3}"
ROUTER="skills/model-router/SKILL.md"
CURSOR_ADAPTER="skills/model-router-cursor/SKILL.md"
CODEX_ADAPTER="skills/model-router-codex/SKILL.md"
failures=0

require_text() {
  local file="$1" text="$2" label="$3"
  if ! grep -Fq -- "$text" "$ROOT/$file"; then
    echo "missing: $label" >&2
    failures=$((failures + 1))
  fi
}

forbid_text() {
  local file="$1" text="$2" label="$3"
  if grep -Fq -- "$text" "$ROOT/$file"; then
    echo "forbidden: $label" >&2
    failures=$((failures + 1))
  fi
}

require_count() {
  local text="$1" expected="$2" label="$3" actual
  actual="$( (grep -RohF --include='SKILL.md' -- "$text" "$ROOT/skills" || true) | wc -l | tr -d ' ')"
  if [[ "$actual" != "$expected" ]]; then
    echo "wrong-count: $label (expected $expected, got $actual)" >&2
    failures=$((failures + 1))
  fi
}

require_text "$ROUTER" "ROUTING_DECISION:" "routing decision contract"
require_text "$ROUTER" "MODEL_ROUTING_REQUEST:" "routing request contract"
require_text "$ROUTER" "ACTION: USE_NATIVE | DELEGATE | STOP" "harness-boundary actions"
require_text "$ROUTER" "CALLER_HARNESS: cursor | codex | claude | pi | other" "caller harness field"
require_text "$ROUTER" "TARGET_TRANSPORT: cursor | codex | pi" "target transport field"
require_text "$ROUTER" "## Model Registry" "central model registry"
require_text "$ROUTER" "| \`cursor\` | \`composer-2.5\` |" "cursor registry model"
require_text "$ROUTER" "| \`codex\` | \`gpt-5.6-sol\` |" "codex registry model"
require_text "$ROUTER" "| \`pi\` | \`opencode-go/minimax-m3\` |" "pi minimax registry model"
require_text "$ROUTER" "| \`pi\` | \`opencode-go/glm-5.2\` |" "pi glm registry model"
require_text "$ROUTER" "Never silently substitute another provider or model." "no substitution"
require_text "$ROUTER" "Pstack is independent and Cursor-native." "pstack independence"
require_text "$ROUTER" "without Ajax supporting it as a DELEGATE target" "caller vs transport split"
require_text "$ROUTER" "DELEGATE_REPORT:" "structured delegate report"
require_text "$ROUTER" "STEPS: []" "verification steps field"
require_text "$ROUTER" "before_execute → snapshot → execute → after_execute → log_outcome" "delegate stages"
require_text "$ROUTER" 'scripts/delegate-delta restore "$SNAP"' "delta restore command"
require_text "$ROUTER" "DISCARD is a verdict, not permission to reset the worktree." "safe discard definition"
require_text "$ROUTER" 'Never use `git reset`' "destructive restore guard"
require_text "$ROUTER" "inspect the actual delta" "parent reviews delta"

forbid_text "$ROUTER" "EXECUTION:" "removed EXECUTION decision"
forbid_text "$ROUTER" "CURRENT_HARNESS: cursor | codex | pi" "replaced CURRENT_HARNESS contract"
forbid_text "$ROUTER" "TARGET_HARNESS: cursor | codex | pi" "replaced TARGET_HARNESS contract"
forbid_text "$ROUTER" "GATHER_EVIDENCE" "removed evidence stage"
forbid_text "$ROUTER" "BUILD_PACKET" "removed packet build stage"
forbid_text "$ROUTER" "CRITIQUE_PACKET" "removed packet critique stage"
forbid_text "$ROUTER" "PACKET_STATUS" "removed packet status"
forbid_text "$ROUTER" "PACKET_REBUILD_COUNT" "removed packet rebuild counter"
forbid_text "$ROUTER" "PACKET_CRITIQUE_COUNT" "removed packet critique counter"
forbid_text "$ROUTER" "tdd-implementation-packet" "removed TDD packet skill"
forbid_text "$ROUTER" "TEST_FIRST" "removed TEST_FIRST"
forbid_text "$ROUTER" "RED | GREEN" "removed RED/GREEN phases"
forbid_text "$ROUTER" "dispatch_level" "removed progressive dispatch levels"
forbid_text "$ROUTER" "estimated_lines" "removed line-count routing"
forbid_text "$ROUTER" "R-SIZE-SPLIT" "removed size-split ceremony"
forbid_text "$ROUTER" "R-CURSOR" "removed semantic R-CURSOR route"
forbid_text "$ROUTER" "R-MINIMAX" "removed semantic R-MINIMAX route"
forbid_text "$ROUTER" "R-GLM" "removed semantic R-GLM route"
forbid_text "$ROUTER" "Default implementation agent is" "removed composer-default implementation lane"
forbid_text "$ROUTER" "## Risk-based review" "removed risk-tier review ceremony"
forbid_text "$ROUTER" "GROK" "no Grok registry or route"
forbid_text "$ROUTER" "grok" "no Grok model id"
forbid_text "$ROUTER" "Complete exactly one bounded task from the packet below." "removed packet-prescriptive prompt"
forbid_text "$ROUTER" "CALIBRATION.md" "no calibration ledger"
forbid_text "$ROUTER" "## Calibration" "no calibration section"

require_text "$CURSOR_ADAPTER" "CALLER_HARNESS is always \`cursor\`" "cursor adapter bind"
require_text "$CODEX_ADAPTER" "CALLER_HARNESS is always \`codex\`" "codex adapter bind"
CLAUDE_ADAPTER="skills/model-router-claude/SKILL.md"
require_text "$CLAUDE_ADAPTER" "CALLER_HARNESS is always \`claude\`" "claude adapter bind"
require_text "$CLAUDE_ADAPTER" "never emits \`USE_NATIVE\`" "claude never USE_NATIVE"
require_text "$CURSOR_ADAPTER" "name: model-router" "cursor adapter visible name"
require_text "$CODEX_ADAPTER" "name: model-router" "codex adapter visible name"

for model_id in composer-2.5 gpt-5.6-sol opencode-go/minimax-m3 opencode-go/glm-5.2; do
  # Shared skill + two adapters pointing via shared-rules symlink resolve to one file;
  # count unique occurrences under skills/*/SKILL.md bodies (adapters are thin).
  :
done

# Exact IDs appear once in the shared registry table (adapters must not duplicate them).
for model_id in "composer-2.5" "gpt-5.6-sol" "opencode-go/minimax-m3" "opencode-go/glm-5.2"; do
  actual="$( (grep -RohF --include='SKILL.md' -- "$model_id" "$ROOT/skills/model-router" "$ROOT/skills/model-router-cursor" "$ROOT/skills/model-router-codex" || true) | wc -l | tr -d ' ')"
  # shared SKILL once; adapters may mention composer/codex in examples — allow thin adapter mentions
  if [[ "$actual" -lt 1 ]]; then
    echo "missing: model id $model_id in shared/adapters" >&2
    failures=$((failures + 1))
  fi
done

for adapter in cursor-delegate pi-delegate codex-delegate; do
  file="skills/$adapter/SKILL.md"
  require_text "$file" "ROUTING_DECISION" "$adapter requires routing decision binding"
  require_text "$file" "ACTION: DELEGATE" "$adapter requires DELEGATE action"
  require_text "$file" 'return `STOP`' "$adapter unavailable-tool behavior"
done

cursor="skills/cursor-delegate/SKILL.md"
forbid_text "$cursor" '`review`' "unroutable Cursor review mode"
forbid_text "$cursor" '`packet-critique`' "removed Cursor critique mode"

codex="skills/codex-delegate/SKILL.md"
forbid_text "$ROUTER" "delegator" "second orchestrator route"
forbid_text "$codex" "delegator" "Codex delegator mode"
forbid_text "$codex" "packet-critique" "removed Codex packet critique"
forbid_text "$codex" "PACKET_REVIEW" "removed packet review schema"
require_text "$codex" '--reasoning-effort xhigh' "Codex xhigh reasoning override"
require_text "$codex" '--tool codex' "Codex routed through the shared app-server runner"

pi="skills/pi-delegate/SKILL.md"
require_text "$pi" 'Headless only.' "Pi headless-only note"
require_text "$pi" 'pi --mode rpc --model "$MODEL" --no-session --no-context-files --no-skills' "Pi verified invocation"
require_text "$pi" 'scripts/run-delegate --tool pi' "Pi bounded runner"
require_text "$pi" 'Exit `124`' "Pi delegate timeout status"

implicit_false_count="$( (grep -RohF --include='openai.yaml' -- 'allow_implicit_invocation: false' "$ROOT/skills" || true) | wc -l | tr -d ' ')"
if [[ "$implicit_false_count" != "3" ]]; then
  echo "wrong-count: delegate implicit activation guards (expected 3, got $implicit_false_count)" >&2
  failures=$((failures + 1))
fi

require_text "README.md" "harness-boundary" "readme harness-boundary framing"
require_text "README.md" "scripts/check-contracts" "contract validator documentation"
require_text "README.md" "USE_NATIVE" "readme USE_NATIVE"

if [[ -e "$ROOT/skills/tdd-implementation-packet" ]]; then
  echo "forbidden: tdd-implementation-packet skill must be deleted" >&2
  failures=$((failures + 1))
fi
if [[ -e "$ROOT/scripts/check-packet" || -e "$ROOT/scripts/check-dispatch" ]]; then
  echo "forbidden: check-packet/check-dispatch must be deleted" >&2
  failures=$((failures + 1))
fi
if [[ -e "$ROOT/CALIBRATION.md" ]]; then
  echo "forbidden: CALIBRATION.md ceremony ledger must be deleted" >&2
  failures=$((failures + 1))
fi

if ! bash -n "$ROOT"/scripts/*; then
  echo "failed: shell syntax" >&2
  failures=$((failures + 1))
fi
if ! "$PYTHON" -m unittest discover -s "$ROOT/tests" -p 'test_*.py'; then
  echo "failed: behavioral contracts" >&2
  failures=$((failures + 1))
fi

if ((failures > 0)); then
  exit 1
fi

echo "contract checks passed"

#!/usr/bin/env bash
# Contract pins for the thin outcome-focused router control plane.
set -euo pipefail

ROOT="$(cd "$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")")/.." && pwd -P)"
ROUTER="skills/model-router/SKILL.md"
failures=0

require_text() {
  local file="$1" text="$2" label="$3"
  if ! grep -Fq -- "$text" "$ROOT/$file"; then
    echo "missing: $label" >&2
    failures=$((failures + 1))
  fi
}

forbid_text() {
  local file="$1" text="$2" label="$3"
  if grep -Fq -- "$text" "$ROOT/$file"; then
    echo "forbidden: $label" >&2
    failures=$((failures + 1))
  fi
}

require_count() {
  local text="$1" expected="$2" label="$3" actual
  actual="$( (grep -RohF --include='SKILL.md' -- "$text" "$ROOT/skills" || true) | wc -l | tr -d ' ')"
  if [[ "$actual" != "$expected" ]]; then
    echo "wrong-count: $label (expected $expected, got $actual)" >&2
    failures=$((failures + 1))
  fi
}

for field in AGENT MODEL RISK SCOPE VERIFY FALLBACK; do
  require_text "$ROUTER" "$field:" "execution decision field $field"
done

require_text "$ROUTER" "## Model Registry" "central model registry"
require_text "$ROUTER" "route → execute → verify" "thin pipeline"
require_text "$ROUTER" "Implement the requested outcome." "outcome-based dispatch"
require_text "$ROUTER" "Investigate the repository as needed." "delegate owns investigation"
require_text "$ROUTER" "Choose the implementation approach." "delegate owns planning"
require_text "$ROUTER" "Before dispatch, the parent must not Grep, Read, or search the repository" "no parent pre-explore before dispatch"
require_text "$ROUTER" "do not explore to perfect scope first" "wrong scope stops delegate not parent explore"
require_text "$ROUTER" "no pre-dispatch repo exploration" "dispatch section no parent explore"
forbid_text "$ROUTER" "GATHER_EVIDENCE" "removed evidence stage"
forbid_text "$ROUTER" "BUILD_PACKET" "removed packet build stage"
forbid_text "$ROUTER" "CRITIQUE_PACKET" "removed packet critique stage"
forbid_text "$ROUTER" "PACKET_STATUS" "removed packet status"
forbid_text "$ROUTER" "PACKET_REBUILD_COUNT" "removed packet rebuild counter"
forbid_text "$ROUTER" "PACKET_CRITIQUE_COUNT" "removed packet critique counter"
forbid_text "$ROUTER" "tdd-implementation-packet" "removed TDD packet skill"
forbid_text "$ROUTER" "TEST_FIRST" "removed TEST_FIRST"
forbid_text "$ROUTER" "RED | GREEN" "removed RED/GREEN phases"
forbid_text "$ROUTER" "dispatch_level" "removed progressive dispatch levels"
forbid_text "$ROUTER" "estimated_lines" "removed line-count routing"
forbid_text "$ROUTER" "R-SIZE-SPLIT" "removed size-split ceremony"
forbid_text "$ROUTER" "GROK" "no Grok registry or route"
forbid_text "$ROUTER" "grok" "no Grok model id"

for key in CODEX CURSOR MINIMAX GLM; do
  model_id="$(awk -F'`' -v key="$key" '$2 == key {print $4; exit}' "$ROOT/$ROUTER")"
  if [[ -z "$model_id" ]]; then
    echo "missing: model registry key $key" >&2
    failures=$((failures + 1))
  else
    require_count "$model_id" 1 "$key model ID outside registry"
  fi
done

require_text "$ROUTER" "Default implementation agent is \`cursor\`" "composer-default implementation"
require_text "$ROUTER" "Pure Q&A or architecture planning" "LOCAL/parent only for Q&A / architecture"
forbid_text "$ROUTER" '`R-LOCAL-TINY`' "removed tiny-local write shortcut"

uncertainty_line="$(grep -nF 'Recorded unresolved specification or architecture uncertainty' "$ROOT/$ROUTER" | head -1 | cut -d: -f1 || true)"
cheap_line="$(grep -nF 'Routine docs, generated cleanup, exact replacements, or named boilerplate' "$ROOT/$ROUTER" | head -1 | cut -d: -f1 || true)"
cursor_line="$(grep -nF 'No exception matched' "$ROOT/$ROUTER" | head -1 | cut -d: -f1 || true)"
if [[ -z "$uncertainty_line" || -z "$cheap_line" || -z "$cursor_line" || "$uncertainty_line" -ge "$cheap_line" || "$cheap_line" -ge "$cursor_line" ]]; then
  echo "wrong-order: GLM → MiniMax → CURSOR-default must hold" >&2
  failures=$((failures + 1))
fi

for adapter in cursor-delegate pi-delegate codex-delegate; do
  file="skills/$adapter/SKILL.md"
  require_text "$file" "EXECUTION" "$adapter requires execution binding"
  require_text "$file" 'return `STOP`' "$adapter unavailable-tool behavior"
done

cursor="skills/cursor-delegate/SKILL.md"
forbid_text "$cursor" '`review`' "unroutable Cursor review mode"
forbid_text "$cursor" '`packet-critique`' "removed Cursor critique mode"

codex="skills/codex-delegate/SKILL.md"
forbid_text "$ROUTER" "delegator" "second orchestrator route"
forbid_text "$codex" "delegator" "Codex delegator mode"
forbid_text "$codex" "packet-critique" "removed Codex packet critique"
forbid_text "$codex" "PACKET_REVIEW" "removed packet review schema"
require_text "$ROUTER" '| `CODEX` | `gpt-5.6-sol` |' "Codex model registry value"
require_text "$codex" '--reasoning-effort xhigh' "Codex xhigh reasoning override"
require_text "$codex" '--tool codex' "Codex routed through the shared acpx runner"
require_text "$codex" 'command -v acpx' "Codex acpx preflight"

pi="skills/pi-delegate/SKILL.md"
require_text "$pi" 'Headless only.' "Pi headless-only note"
require_text "$pi" 'acpx ACP (`pi` profile)' "Pi verified acpx invocation"
require_text "$pi" '--model "$MODEL"' "Pi passes router model through acpx"
require_text "$pi" 'scripts/run-delegate --tool pi' "Pi bounded runner"
require_text "$pi" 'Exit `124`' "Pi delegate timeout status"
require_text "$pi" 'command -v acpx' "Pi acpx preflight"

require_text "$ROUTER" "Never spawn native Cursor Task, best-of-n, or any other subagent." "dispatch forbids Task fan-out"
require_text "$cursor" "Do not spawn native Task, best-of-n, or other Cursor subagents." "cursor adapter forbids Task"
require_text "$cursor" "command -v acpx" "Cursor acpx preflight"
require_text "$cursor" 'acpx ACP (`cursor` profile)' "Cursor verified acpx invocation"
require_text "README.md" "acpx" "readme acpx transport"
forbid_text "README.md" "cursor-agent -p" "forbidden legacy Cursor CLI transport"
forbid_text "README.md" "codex app-server" "forbidden legacy Codex app-server transport"
forbid_text "README.md" "pi --mode rpc" "forbidden legacy Pi RPC transport"
forbid_text "$cursor" "cursor-agent" "forbidden legacy cursor-agent in adapter"
forbid_text "$pi" "pi --mode rpc" "forbidden legacy pi rpc in adapter"
forbid_text "$codex" "codex app-server" "forbidden legacy codex app-server in adapter"

implicit_false_count="$( (grep -RohF --include='openai.yaml' -- 'allow_implicit_invocation: false' "$ROOT/skills" || true) | wc -l | tr -d ' ')"
if [[ "$implicit_false_count" != "3" ]]; then
  echo "wrong-count: delegate implicit activation guards (expected 3, got $implicit_false_count)" >&2
  failures=$((failures + 1))
fi

require_text "$ROUTER" "DELEGATE_REPORT:" "structured delegate report"
require_text "$ROUTER" "## Risk-based review" "proportional review"
require_text "$ROUTER" "Delegate verification is sufficient by default." "low-risk review"
require_text "$ROUTER" "Parent reads all changed hunks." "medium-risk review"
require_text "$ROUTER" "Parent independently reviews affected behavior." "high-risk review"
require_text "$ROUTER" "## Outcome logging" "outcome logging"
require_text "$ROUTER" "requested_agent:" "outcome log field"
require_text "$ROUTER" "before_execute → snapshot → execute → after_execute → log_outcome" "thin execute stages"
require_text "$ROUTER" 'scripts/delegate-delta restore "$SNAP"' "delta restore command"
require_text "$ROUTER" "DISCARD is a verdict, not permission to reset the worktree." "safe discard definition"
require_text "$ROUTER" 'Never use `git reset`' "destructive restore guard"
require_text "$ROUTER" "Stop if completing the task requires expanding beyond the allowed scope." "scope expansion stop"
forbid_text "$ROUTER" "Complete exactly one bounded task from the packet below." "removed packet-prescriptive prompt"
require_text "README.md" "thin control plane" "readme control-plane framing"
require_text "README.md" "scripts/check-contracts" "contract validator documentation"

if [[ -e "$ROOT/skills/tdd-implementation-packet" ]]; then
  echo "forbidden: tdd-implementation-packet skill must be deleted" >&2
  failures=$((failures + 1))
fi
if [[ -e "$ROOT/scripts/check-packet" || -e "$ROOT/scripts/check-dispatch" ]]; then
  echo "forbidden: check-packet/check-dispatch must be deleted" >&2
  failures=$((failures + 1))
fi
if [[ -e "$ROOT/CALIBRATION.md" ]]; then
  echo "forbidden: CALIBRATION.md ceremony ledger must be deleted" >&2
  failures=$((failures + 1))
fi

if ! bash -n "$ROOT"/scripts/*; then
  echo "failed: shell syntax" >&2
  failures=$((failures + 1))
fi
if ! python3 -m unittest discover -s "$ROOT/tests" -p 'test_*.py'; then
  echo "failed: behavioral contracts" >&2
  failures=$((failures + 1))
fi

if ((failures > 0)); then
  exit 1
fi

echo "contract checks passed"

#!/usr/bin/env bash
set -euo pipefail

SRC="${BASH_SOURCE[0]}"
while [[ -L "$SRC" ]]; do LINK="$(readlink "$SRC")"; [[ "$LINK" == /* ]] && SRC="$LINK" || SRC="$(dirname "$SRC")/$LINK"; done
ROOT="$(cd "$(dirname "$SRC")/.." && pwd -P)"
export PYTHONPATH="$ROOT/libexec${PYTHONPATH:+:$PYTHONPATH}"
exec "$ROOT/libexec/python" -c "import sys; from semantic import analyze_task_main; raise SystemExit(analyze_task_main(sys.argv[1:]))" "$@"

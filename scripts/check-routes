#!/usr/bin/env bash
set -euo pipefail

# Probe every registry route and refresh the route-health cache.
SRC="${BASH_SOURCE[0]}"
while [[ -L "$SRC" ]]; do LINK="$(readlink "$SRC")"; [[ "$LINK" == /* ]] && SRC="$LINK" || SRC="$(dirname "$SRC")/$LINK"; done
ROOT="$(cd "$(dirname "$SRC")/.." && pwd -P)"
export PYTHONPATH="$ROOT/libexec${PYTHONPATH:+:$PYTHONPATH}"
exec "$ROOT/libexec/python" "$ROOT/libexec/route_health.py" "$@"

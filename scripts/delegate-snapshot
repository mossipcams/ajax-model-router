#!/usr/bin/env bash
set -euo pipefail

# Resolve through symlinks so worktree installs still find canonical libexec.
SRC="${BASH_SOURCE[0]}"
while [[ -L "$SRC" ]]; do LINK="$(readlink "$SRC")"; [[ "$LINK" == /* ]] && SRC="$LINK" || SRC="$(dirname "$SRC")/$LINK"; done
ROOT="$(cd "$(dirname "$SRC")/.." && pwd -P)"
exec "$ROOT/libexec/python" "$ROOT/libexec/router_state.py" capture "$@"

#!/usr/bin/env bash
set -euo pipefail

LOG="${1:-${HOME}/.ajax-router/outcome.tsv}"
[[ -f "$LOG" ]] || { echo "no log at $LOG" >&2; exit 1; }

awk -F'\t' '
  $1 == "v1" && NF >= 9 {
    total++
    requested[$3]++
    actual[$4]++
    if ($5 == "true") success++
    if ($5 == "false") fail++
    if ($6 == "true") revise++
    if ($7 == "true") escaped++
  }
  END {
    printf "rows: %d\n", total+0
    printf "success: %d  fail/reject: %d  revision_needed: %d  escaped_defect: %d\n",
      success+0, fail+0, revise+0, escaped+0
    printf "\n# requested_agent\n"
    for (k in requested) printf "%4d  %s\n", requested[k], k | "sort -rn"
    close("sort -rn")
    printf "\n# actual_agent\n"
    for (k in actual) printf "%4d  %s\n", actual[k], k | "sort -rn"
    close("sort -rn")
  }
' "$LOG"

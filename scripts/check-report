#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 1 && -f "$1" ]] || {
  echo "Usage: scripts/check-report REPORT.yaml" >&2
  exit 2
}

report="$1"
failures=0

require() {
  local pattern="$1" label="$2"
  if ! grep -Eq -- "$pattern" "$report"; then
    echo "missing-or-invalid: $label" >&2
    failures=$((failures + 1))
  fi
}

case "$(sed -n '1p' "$report")" in
  DELEGATE_REPORT:)
    require '^  STATUS: (COMPLETE|BLOCKED|FAILED)$' STATUS
    require '^  CHANGED_FILES: ' CHANGED_FILES
    require '^  VERIFICATION:' VERIFICATION
    require '^  CONCERNS:' CONCERNS

    status="$(sed -n 's/^  STATUS: //p' "$report" | head -1)"
    methods="$(grep -Ec '^    - TYPE: (test|existing_test|build|typecheck|lint|static_analysis|integration|browser|manual|other)$' "$report" || true)"
    results="$(grep -Ec '^      RESULT: (pass|fail|skipped|blocked)$' "$report" || true)"

    if [[ "$status" == COMPLETE ]]; then
      if [[ "$methods" -eq 0 ]]; then
        echo "missing: VERIFICATION methods for COMPLETE" >&2
        failures=$((failures + 1))
      fi
      if [[ "$methods" != "$results" ]]; then
        echo "incomplete: VERIFICATION RESULT" >&2
        failures=$((failures + 1))
      fi
      if grep -Eq '^      RESULT: fail$' "$report"; then
        echo "invalid: COMPLETE report contains failing verification" >&2
        failures=$((failures + 1))
      fi
    elif [[ "$status" == BLOCKED ]]; then
      concerns="$(grep -Ec '^    - TYPE: .+' "$report" || true)"
      if [[ "$concerns" -eq 0 ]] && ! grep -Eq '^  CONCERNS: \[.+\]$' "$report"; then
        echo "invalid: BLOCKED requires concerns" >&2
        failures=$((failures + 1))
      fi
    fi
    ;;
  *)
    echo "unknown report schema (expected DELEGATE_REPORT)" >&2
    failures=$((failures + 1))
    ;;
esac

((failures == 0)) || exit 1
echo "report checks passed"

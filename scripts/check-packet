#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 1 && -f "$1" ]] || {
  echo "Usage: scripts/check-packet PACKET.md" >&2
  exit 2
}

packet="$1"
failures=0
legacy=0

require_pattern() {
  local pattern="$1" label="$2"
  if ! grep -Eq -- "$pattern" "$packet"; then
    echo "missing-or-invalid: $label" >&2
    failures=$((failures + 1))
  fi
}

require_section() {
  local section="$1"
  if ! awk -v heading="## $section" '
    $0 == heading {inside=1; next}
    inside && /^## / {exit}
    inside && NF {found=1}
    END {exit !found}
  ' "$packet"; then
    echo "missing-or-empty: $section" >&2
    failures=$((failures + 1))
  fi
}

# Legacy TDD packets remain readable; warn and validate the old contract.
if grep -Eq '^TEST_FIRST: (REQUIRED|NOT_APPLICABLE)$' "$packet" \
  || grep -Fxq '## Test-first instructions' "$packet"; then
  legacy=1
  echo "deprecated: legacy TDD packet fields detected; RED/GREEN sequencing is ignored" >&2

  require_pattern '^PACKET_STATUS: READY$' "PACKET_STATUS"
  require_pattern '^TASK_KIND: (behavior|tests-only|docs-only|mechanical)$' "TASK_KIND"
  require_pattern '^TEST_FIRST: (REQUIRED|NOT_APPLICABLE)$' "TEST_FIRST"
  require_pattern '^PRODUCTION_EDIT: (REQUIRED|FORBIDDEN)$' "PRODUCTION_EDIT"
  require_pattern '^UNRESOLVED_UNCERTAINTY: (NONE|SPECIFICATION|ARCHITECTURE|BOTH)$' "UNRESOLVED_UNCERTAINTY"
  require_pattern '^BLOCKERS: \[\]$' "empty BLOCKERS"

  for section in \
    "Goal" \
    "Allowed files" \
    "Forbidden changes" \
    "Context evidence" \
    "Code anchors" \
    "Test-first instructions" \
    "Edit instructions" \
    "Verification commands" \
    "Acceptance criteria" \
    "Stop conditions"
  do
    require_section "$section"
  done

  # No longer enforce behavior=>TEST_FIRST REQUIRED. Only structural presence.
  ((failures == 0)) || exit 1
  echo "packet checks passed (legacy TDD, deprecated)"
  exit 0
fi

require_pattern '^PACKET_STATUS: READY$' "PACKET_STATUS"
require_pattern '^UNRESOLVED_UNCERTAINTY: (NONE|SPECIFICATION|ARCHITECTURE|BOTH)$' "UNRESOLVED_UNCERTAINTY"
require_pattern '^BLOCKERS: \[\]$' "empty BLOCKERS"

# Prefer the outcome-based headings; accept Goal/Acceptance criteria aliases.
if grep -Fxq '## Task' "$packet"; then
  require_section "Task"
else
  require_section "Goal"
fi

if grep -Fxq '## Scope' "$packet"; then
  require_section "Scope"
else
  require_section "Allowed files"
  require_section "Forbidden changes"
fi

if grep -Fxq '## Acceptance' "$packet"; then
  require_section "Acceptance"
else
  require_section "Acceptance criteria"
fi

require_section "Verification"

if grep -Fxq '## Stop if' "$packet"; then
  require_section "Stop if"
else
  require_section "Stop conditions"
fi

# Reject empty/vague verification: must name at least one method/type or command.
if ! awk '
  $0 == "## Verification" {inside=1; next}
  inside && /^## / {exit}
  inside && /type:|TYPE:|command:|COMMAND:|- / {found=1}
  END {exit !found}
' "$packet"; then
  echo "missing-or-vague: Verification must list methods, commands, or steps" >&2
  failures=$((failures + 1))
fi

# Forbid leftover mandatory TDD-only contract fields in new packets.
if grep -Eq '^TEST_FIRST:' "$packet"; then
  echo "forbidden: TEST_FIRST in non-legacy packet" >&2
  failures=$((failures + 1))
fi
if grep -Fxq '## Test-first instructions' "$packet"; then
  echo "forbidden: Test-first instructions in non-legacy packet" >&2
  failures=$((failures + 1))
fi

((failures == 0)) || exit 1
echo "packet checks passed"

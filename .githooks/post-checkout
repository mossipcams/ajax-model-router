#!/usr/bin/env bash
# Guard: the canonical router checkout is what every global and repo skill
# symlink points at, so it must stay on main. Enable once in that checkout:
#   git config core.hooksPath .githooks
# Linked worktrees, file checkouts, and in-progress rebase/bisect are left alone.
[ "$3" = "1" ] || exit 0

git_dir="$(cd "$(git rev-parse --git-dir)" && pwd -P)"
common_dir="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
[ "$git_dir" = "$common_dir" ] || exit 0

for op in rebase-merge rebase-apply BISECT_LOG; do
  [ -e "$git_dir/$op" ] && exit 0
done

[ "$(git branch --show-current)" = "main" ] && exit 0

top="$(git rev-parse --show-toplevel)"
echo "post-checkout guard: $top must stay on main (skill symlinks point here); switching back." >&2
if ! git checkout --quiet main; then
  echo "post-checkout guard: FAILED to return to main. Run: git -C $top checkout main" >&2
  exit 1
fi
